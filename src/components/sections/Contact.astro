---
import { basics } from '@cv'

const { email } = basics
---

<section class="contact" aria-labelledby="h-contact">
  <div>
    <h2 id="h-contact">¿Arrancamos algo?</h2>
    <p>Correo directo, sin formularios ni intermediarios.</p>
  </div>

  {
    email && (
      <a class="mail" href={`mailto:${email}`}>
        {email} →
      </a>
    )
  }
</section>

<style>
  .contact {
    margin-top: clamp(28px, 5vw, 52px);
    border: 2px solid var(--ink);
    background: var(--accent);
    box-shadow: 8px 8px 0 var(--ink);
    padding: clamp(22px, 4vw, 40px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
  }

  h2 {
    font-size: clamp(1.5rem, 4.6vw, 2.6rem);
    line-height: 0.95;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    max-width: 22ch;
  }

  p {
    font-size: 0.88rem;
    margin-top: 10px;
    color: var(--ink-soft);
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 22px;
    background: var(--ink);
    color: var(--accent);
    font-weight: 800;
    font-size: 0.88rem;
    border: 2px solid var(--ink);
    white-space: nowrap;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .mail:hover {
    background: var(--navy);
    color: #fff;
  }

  @media (max-width: 880px) {
    .contact {
      grid-template-columns: 1fr;
    }

    .mail {
      justify-content: center;
      white-space: normal;
      word-break: break-word;
      text-align: center;
    }
  }
</style>
