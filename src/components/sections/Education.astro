---
import Section from '@/components/Section.astro'
import Entry from '@/components/Entry.astro'
import { education } from '@cv'

// un curso en curso no tiene fecha de fin: `new Date(null)` daría 1970
// getUTCFullYear: las fechas ISO sin hora se parsean en UTC y getFullYear
// las leería en la zona del build (un 1 de enero se vuelve el año anterior)
const yearOf = (date: string | null) =>
  date ? new Date(date).getUTCFullYear() : null

const years = education.flatMap(({ startDate, endDate }) => [
  yearOf(startDate),
  yearOf(endDate),
])

// la serie queda abierta si hay un curso sin fecha de fin: se mira endDate,
// no los años, para no confundirlo con un registro sin fecha de inicio
const ongoing = education.some(({ endDate }) => endDate === null)
const known = years.filter((year): year is number => year !== null)

const tag = known.length
  ? `${Math.min(...known)} → ${ongoing ? 'actual' : Math.max(...known)}`
  : undefined
---

<Section
  id="formacion"
  title="Formación"
  tag={tag}
  note="Formación reglada, con los contenidos que sigo usando hoy."
>
  <div class="rows">
    {
      education.map(
        ({ institution, url, area, studyType, startDate, endDate, score, courses }) => (
          <Entry
            period={`${yearOf(startDate)} — ${yearOf(endDate) ?? 'actual'}`}
            datetime={startDate}
            title={institution}
            subtitle={studyType}
            detail={`${area}. Nota media ${score}. ${courses.join(', ')}.`}
            href={url}
          />
        )
      )
    }
  </div>
</Section>

<style>
  .rows {
    display: grid;
    gap: 12px;
  }
</style>
