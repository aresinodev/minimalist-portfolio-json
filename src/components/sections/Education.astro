---
import Section from '@/components/Section.astro'
import Entry from '@/components/Entry.astro'
import { education } from '@cv'

// un curso en curso no tiene fecha de fin: `new Date(null)` daría 1970
const yearOf = (date: string | null) =>
  date ? new Date(date).getFullYear() : null

const years = education
  .flatMap(({ startDate, endDate }) => [yearOf(startDate), yearOf(endDate)])
  .filter((year): year is number => year !== null)

const tag = years.length
  ? `${Math.min(...years)} → ${Math.max(...years)}`
  : undefined
---

<Section
  id="formacion"
  title="Formación"
  tag={tag}
  note="Formación reglada, con los contenidos que sigo usando hoy."
>
  <div class="rows">
    {
      education.map(
        ({ institution, url, area, studyType, startDate, endDate, score, courses }) => (
          <Entry
            period={`${yearOf(startDate)} — ${yearOf(endDate) ?? 'actual'}`}
            datetime={startDate}
            title={institution}
            subtitle={studyType}
            detail={`${area}. Nota media ${score}. ${courses.join(', ')}.`}
            href={url}
          />
        )
      )
    }
  </div>
</Section>

<style>
  .rows {
    display: grid;
    gap: 12px;
  }
</style>
