---
import Section from '@/components/Section.astro'
import Entry from '@/components/Entry.astro'
import { education } from '@cv'

const yearOf = (date: string) => new Date(date).getFullYear()
const years = education.flatMap(({ startDate, endDate }) => [
  yearOf(startDate),
  yearOf(endDate),
])
const tag = `${Math.min(...years)} → ${Math.max(...years)}`
---

<Section
  id="formacion"
  title="Formación"
  tag={tag}
  note="Formación reglada, con los contenidos que sigo usando hoy."
>
  <div class="rows">
    {
      education.map(
        ({ institution, url, area, studyType, startDate, endDate, score, courses }) => (
          <Entry
            period={`${yearOf(startDate)} — ${yearOf(endDate)}`}
            datetime={startDate}
            title={institution}
            subtitle={studyType}
            detail={`${area}. Nota media ${score}. ${courses.join(', ')}.`}
            href={url}
          />
        )
      )
    }
  </div>
</Section>

<style>
  .rows {
    display: grid;
    gap: 12px;
  }
</style>
