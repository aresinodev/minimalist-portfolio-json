---
import Section from '@/components/Section.astro'
import Entry from '@/components/Entry.astro'
import { work } from '@cv'

const yearOf = (date: string | null) =>
  date ? new Date(date).getFullYear() : 'actual'
---

<Section
  id="experiencia"
  title="Experiencia"
  tag="2017 → hoy"
  note="Cuatro etapas, un mismo oficio: producto real, en equipos reales."
>
  <div class="jobs">
    {
      work.map(({ name, position, url, startDate, endDate, summary }) => (
        <Entry
          period={`${yearOf(startDate)} — ${yearOf(endDate)}`}
          datetime={startDate}
          title={name}
          subtitle={position}
          detail={summary}
          href={url}
          current={endDate === null}
        />
      ))
    }
  </div>
</Section>

<style>
  .jobs {
    display: grid;
    gap: 12px;
  }
</style>
