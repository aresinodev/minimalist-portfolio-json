---
import Section from '@/components/Section.astro'
import Entry from '@/components/Entry.astro'
import { work } from '@cv'

const yearOf = (date: string | null) =>
  date ? new Date(date).getFullYear() : 'actual'

// el encabezado se deriva de los datos, no se escribe a mano
const starts = work.map(({ startDate }) => new Date(startDate).getFullYear())
const open = work.some(({ endDate }) => endDate === null)
const ends = work
  .map(({ endDate }) => (endDate ? new Date(endDate).getFullYear() : null))
  .filter((year): year is number => year !== null)

const tag = `${Math.min(...starts)} → ${open ? 'hoy' : String(Math.max(...ends))}`
const note = `${work.length} etapas, un mismo oficio: producto real, en equipos reales.`
---

<Section
  id="experiencia"
  title="Experiencia"
  tag={tag}
  note={note}
>
  <div class="jobs">
    {
      work.map(({ name, position, url, startDate, endDate, summary }) => (
        <Entry
          period={`${yearOf(startDate)} — ${yearOf(endDate)}`}
          datetime={startDate}
          title={name}
          subtitle={position}
          detail={summary}
          href={url}
          current={endDate === null}
        />
      ))
    }
  </div>
</Section>

<style>
  .jobs {
    display: grid;
    gap: 12px;
  }
</style>
