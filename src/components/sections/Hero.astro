---
import { Picture } from 'astro:assets'
import { basics } from '@cv'

// La foto vive en el repo: el campo `image` de cv.json apuntaba a imgur
// y el sitio no debe depender de un tercero para un asset propio.
import retrato from '@/assets/retrato.avif'

const { name, headline, summary, location } = basics
const { city, region } = location

const [firstWord, ...restWords] = headline.split(' ')
const rest = restWords.join(' ')
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-top">
    <div class="hero-lead">
      <h1 id="hero-title">
        {firstWord}<br />
        <span class="box">{rest}</span>
      </h1>
    </div>

    <div class="portrait-col">
      <figure class="portrait">
        <Picture
          src={retrato}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt={`Retrato de ${name}`}
          width={440}
          height={440}
          quality={62}
          loading="eager"
        />
      </figure>
      <p class="where">{city} · {region}</p>
    </div>
  </div>

  <div class="hero-side">
    <p class="summary">{summary}</p>
  </div>
</section>

<style>
  .hero {
    padding: clamp(32px, 6vw, 72px) 0 clamp(28px, 4vw, 48px);
    border-bottom: 2px solid var(--ink);
  }

  /* retrato y titular como un solo bloque, centrado en el ancho */
  .hero-top {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    column-gap: clamp(20px, 3vw, 40px);
    width: min(100%, 780px);
    margin-inline: auto;
    align-items: start;
  }

  .hero-lead {
    grid-column: 2;
    grid-row: 1;
    container-type: inline-size;
  }

  h1 {
    font-size: clamp(2.4rem, 16cqi, 5.7rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .box {
    display: inline-block;
    background: var(--accent);
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    padding: 0 0.08em;
    /* el margen inferior reserva sitio para la sombra de 5px */
    margin: 0.06em 0 0.26em 0;
  }

  .portrait-col {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .portrait {
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    /* lo que se alinea con el capóptico del titular es la fotografía, no
       el marco: 8.6px de aire del line-height 0.86 menos 2px del borde */
    margin-top: calc(8.6px - 2px);
  }

  .portrait :global(picture) {
    display: block;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12);
  }

  .where {
    font-family: var(--mono);
    font-size: 0.57rem;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  .hero-side {
    border: 2px solid var(--ink);
    background: #fff;
    padding: 16px;
    margin-top: clamp(14px, 1.8vw, 22px);
  }

  .summary {
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  @media (max-width: 1080px) {
    .hero-top {
      grid-template-columns: 176px minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .hero-top {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }

    .hero-lead,
    .portrait-col {
      grid-column: auto;
      grid-row: auto;
    }

    /* en una sola columna el titular y el retrato quedan centrados */
    .hero-lead {
      text-align: center;
    }

    h1 {
      font-size: clamp(2rem, 13vw, 5.7rem);
    }

    .portrait-col {
      align-items: center;
      text-align: center;
    }

    .portrait {
      width: min(220px, 62%);
      margin-top: calc(1.3vw - 2px);
    }
  }
</style>
