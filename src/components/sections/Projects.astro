---
import Section from '@/components/Section.astro'
import GitHub from '@/icons/Github.astro'
import { projects } from '@cv'

// la etiqueta cuenta solo lo que está en línea: `isActive` es el dato
const online = projects.filter(({ isActive }) => isActive).length
---

<Section
  id="proyectos"
  title="Proyectos"
  tag={`${online} online`}
  note="Cada uno con un stack distinto, por decisión, no por accidente."
>
  <div class="grid">
    {
      projects.map(({ name, description, highlights, url, github, isActive }, index) => (
        <article class="card">
          <p class="n">
            {String(index + 1).padStart(2, '0')}
            {!isActive && <span class="state">Archivado</span>}
          </p>
          <h3>{name}</h3>
          <p class="description">{description}</p>
          <p class="stack">
            {highlights.map((highlight) => (
              <span>{highlight}</span>
            ))}
          </p>
          <p class="links">
            <a class="go" href={url} target="_blank" rel="noopener noreferrer">
              Ver sitio ↗
            </a>
            {github && (
              <a
                class="code"
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                title={`Ver código fuente del proyecto ${name}`}
              >
                <GitHub aria-hidden="true" />
                <span class="sr-only">Código de {name}</span>
              </a>
            )}
          </p>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }

  .card {
    border: 2px solid var(--ink);
    background: #fff;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .n {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .state {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 0 5px;
    margin-left: 6px;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }

  .description {
    font-size: 0.85rem;
    color: var(--ink-soft);
    flex: 1;
    text-wrap: pretty;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack span {
    /* altura fija: el texto no deja aire de más abajo */
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 7px;
    line-height: 1;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    min-height: 32px;
    font-weight: 700;
    /* encoge anclado a la izquierda para que el texto no se desplace */
    transform-origin: left center;
    transition: transform 0.16s ease;
  }

  .go:hover,
  .go:focus-visible {
    transform: scale(0.93);
  }

  .code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--ink);
  }

  .code:hover {
    color: var(--accent);
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .go:hover,
    .go:focus-visible {
      transform: none;
    }
  }
</style>
