---
import Section from '@/components/Section.astro'
import { skills } from '@cv'
---

<Section
  id="habilidades"
  title="Habilidades"
  tag={String(skills.length)}
  note="Lo que uso hoy, con el nivel real y sin adornos."
>
  <ul class="chips">
    {
      skills.map(({ name, level }) => (
        <li class="chip">
          {name} <em>· {level.toLowerCase()}</em>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    /* sin hover: no son clicables, no deben sugerir interacción */
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    border: 2px solid var(--ink);
    background: #fff;
    padding: 5px 12px;
    font-size: 0.84rem;
    font-weight: 600;
  }

  em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
</style>
